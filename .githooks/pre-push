#!/usr/bin/env bash
# The machine's own pre-push hook first (scripts/machine-hook.sh), then this repo's leak check.
# The refs being pushed arrive once on stdin, so they're read here and handed on.
top="$(git rev-parse --show-toplevel)"
input="$(cat)"
printf '%s\n' "$input" | bash "$top/scripts/machine-hook.sh" pre-push "$@" || exit 1
exec bash "$top/scripts/leak-check.sh" --all
